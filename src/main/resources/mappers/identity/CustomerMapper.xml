<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lab.financialapi.identity.CustomerMapper">
    <select id="findByAuthSubject" resultType="lab.financialapi.identity.Customer">
        SELECT id, auth_subject, name, created_at FROM customer WHERE auth_subject = #{authSubject}
    </select>
</mapper>
