# Local synthetic-data development only. Do not use these credentials elsewhere.
POSTGRES_DB=financial_api_defense_lab
POSTGRES_USER=financial_api_lab
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Trusted JWT verifier settings. Replace the public-key path before local startup.
# Issuer is compared as a claim; this configuration does not contact that URL.
JWT_ISSUER=https://issuer.local.invalid
JWT_AUDIENCE=financial-api-defense-lab
JWT_PUBLIC_KEY_LOCATION=file:C:/path/to/trusted-public-key.pem

# Required: Base64-encoded random secret of at least 32 bytes for audit pseudonyms.
# Supply your own value; no default audit secret is shipped.
AUDIT_RESOURCE_HMAC_KEY=
